#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting an update

gum style --border normal --border-foreground 198 --padding "1 2" \
  "🚀 Ready to update X64 LIOS?" \
  "" \
  "✨ Últimas versiones Rolling Release de CachyOS y Arch Linux." \
  "✨ Novedades y parches oficiales de X64 LIOS + Omarchy." \
  "" \
  "⚠️  No interrumpas el proceso una vez iniciado." \
  "⚡ Asegúrate de estar conectado a la corriente."

echo

if ! gum confirm --affirmative "Sí, continuar" --negative "Cancelar" "¿Iniciar proceso de actualización?"; then
  echo "Actualización cancelada por el usuario."
  exit 1
fi
