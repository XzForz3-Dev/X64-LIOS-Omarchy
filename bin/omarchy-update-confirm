#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting an update

border="\033[1;31m"
reset="\033[0m"
title="\033[1;37m"
val="\033[0;37m"
cyan="\033[1;36m"
warn="\033[1;33m"
green="\033[1;32m"

kernel_ver=$(uname -r 2>/dev/null || echo "Linux")
current_time=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)

echo -e "  ${border}─────────────────────────────────────────────────────────────────────────────${reset}"
echo -e "   ${title}$(omarchy-i18n update.centerTitle) · $(omarchy-i18n update.ready)${reset}"
echo -e "  ${border}─────────────────────────────────────────────────────────────────────────────${reset}"
printf "    ${cyan}%-14s${reset} ${val}%-22s${reset} ${cyan}%-10s${reset} ${val}%-24s${reset}\n" "$(omarchy-i18n update.telemetrySystem)" "X64 LIOS Linux" "$(omarchy-i18n update.telemetryKernel)" "$kernel_ver"
printf "    ${cyan}%-14s${reset} ${val}%-22s${reset} ${cyan}%-10s${reset} ${val}%-24s${reset}\n" "$(omarchy-i18n update.telemetryChannel)" "Rolling Release" "$(omarchy-i18n update.telemetryDate)" "$current_time"
echo ""
echo -e "    ${green}[✓]${reset} ${val}$(omarchy-i18n update.syncRepos)${reset}"
echo -e "    ${green}[✓]${reset} ${val}$(omarchy-i18n update.x64Patches)${reset}"
echo -e "    ${green}[✓]${reset} ${val}$(omarchy-i18n update.snapshotBtrfs)${reset}"
echo -e "    ${cyan}[i]${reset} ${val}$(omarchy-i18n update.whatsNew "https://github.com/XzForz3-Dev/X64-LIOS-Omarchy")${reset}"
echo ""
echo -e "  ${border}─────────────────────────────────────────────────────────────────────────────${reset}"
echo -e "   ${title}$(omarchy-i18n update.importantWarnings)${reset}"
echo -e "  ${border}─────────────────────────────────────────────────────────────────────────────${reset}"
echo -e "    ${warn}[!]${reset} ${val}$(omarchy-i18n update.noShutdown)${reset}"
echo -e "    ${warn}[!]${reset} ${val}$(omarchy-i18n update.cannotStop)${reset}"
echo -e "    ${warn}[!]${reset} ${val}$(omarchy-i18n update.connectPower)${reset}"
echo ""
echo -e "  ${border}─────────────────────────────────────────────────────────────────────────────${reset}"
echo ""

if ! gum confirm "  $(omarchy-i18n update.continue)" \
  --prompt.foreground 196 \
  --affirmative "  [ $(omarchy-i18n update.btnContinue) ]  " \
  --negative "  [ $(omarchy-i18n update.btnCancel) ]  " \
  --selected.background 196 \
  --selected.foreground 255 \
  --unselected.background 235 \
  --unselected.foreground 250; then
  echo -e "\n  \033[1;33m[i] $(omarchy-i18n update.cancelled)\033[0m\n"
  exit 1
fi
