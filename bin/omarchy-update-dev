#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

# Ensure safe.directory is configured for root and user
git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
  sudo -u "$SUDO_USER" git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
fi

_git() {
  if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
    sudo -u "$SUDO_USER" git -C "$OMARCHY_PATH" "$@"
  else
    git -C "$OMARCHY_PATH" "$@"
  fi
}

upstream=$(_git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy git update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nActualizando entorno X64 LIOS + Omarchy desde Git...\e[0m"

# Fetch latest changes
_git fetch --quiet || true

# Pull fast-forward or autostash if user had local adjustments
if ! _git merge --ff-only "@{upstream}" 2>/dev/null; then
  echo -e "\e[33mDetectados ajustes locales. Aplicando autostash seguro...\e[0m"
  _git pull --rebase --autostash || true
fi
