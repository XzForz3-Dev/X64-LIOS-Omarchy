#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

# Ensure safe.directory is configured for root and user
git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
  sudo -u "$SUDO_USER" git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
else
  sudo git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
fi

repo_owner=$(stat -c '%U' "$OMARCHY_PATH/.git" 2>/dev/null || stat -c '%U' "$OMARCHY_PATH" 2>/dev/null || echo "root")

_git() {
  if [[ "$repo_owner" == "root" ]]; then
    if (( EUID == 0 )); then
      git -C "$OMARCHY_PATH" "$@"
    else
      sudo git -C "$OMARCHY_PATH" "$@"
    fi
  elif (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
    sudo -u "$SUDO_USER" git -C "$OMARCHY_PATH" "$@"
  else
    git -C "$OMARCHY_PATH" "$@"
  fi
}

upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]] && git -C "$OMARCHY_PATH" rev-parse --verify origin/main >/dev/null 2>&1; then
  upstream="origin/main"
fi

if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy git update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\n\033[1;31m►\033[0m \033[1;37m$(omarchy-i18n update.stepGit)\033[0m"

# Fetch latest changes
_git fetch --quiet || true

# Pull fast-forward or autostash if user had local adjustments
if ! _git merge --ff-only "@{upstream}" 2>&1 | sed 's/^/   /'; then
  echo -e "   \033[1;33mDetectados ajustes locales. Aplicando autostash seguro...\033[0m"
  _git pull --rebase --autostash 2>&1 | sed 's/^/   /' || true
fi
