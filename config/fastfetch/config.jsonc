    "separator",
    {
      "type": "os",
      "key": "╭─  OS",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "├─  Kernel",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "├─ 󰏖 Pkgs",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "├─  Shell",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "├─  WM",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": "╰─  Term",
      "keyColor": "red"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─  CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "├─  RAM",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "╰─  Disk",
