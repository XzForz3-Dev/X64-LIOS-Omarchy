{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/omarchy/logo.txt",
    "type": "file",
    "color": {"1": "red"}
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "red",
      "title": "red"
    }
